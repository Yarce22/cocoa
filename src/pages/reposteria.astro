---
import Layout from '../layouts/Layout.astro';
import PaginaServicios from '../components/PaginaServicios.astro';
import { getPage, getSettings } from '../lib/sanity';
const p = (await getPage('reposteria')) ?? {};
const s = (await getSettings()) ?? {};
---
<Layout seo={p.seo} title="Repostería por encargo · Cocoa" description="Tortas, postres individuales, galletas y mesas de dulces horneados a mano en Pereira. Pedidos personalizados para tu celebración." mainClass="inner">
<PaginaServicios p={p} boton={s.botonCotizar} />
</Layout>
