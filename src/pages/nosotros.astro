---
import Layout from '../layouts/Layout.astro';
import Titular from '../components/Titular.astro';
import Foto from '../components/Foto.astro';
import { getPage, getTeam } from '../lib/sanity';
const p = (await getPage('nosotros')) ?? {};
const team = await getTeam();
const ICONOS: Record<string, string> = {
  gorro: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M7 20c-2.5 0-4-2-3.5-4.5C4 13 6 12 7.5 12.5 7.5 9.5 10 7.5 12.5 8.5 14 6.5 18 7 18 10.5c2 .5 2.5 3.5 1 5L17.5 20z"></path><path d="M8 20h9.5"></path></svg>',
  hoja: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 21c-4-3-7-6.5-7-10.5C5 7 8 4 12 3c4 1 7 4 7 7.5 0 4-3 7.5-7 10.5z"></path><path d="M12 21V9"></path><path d="M12 13l-3-2.5M12 16l3-2.5"></path></svg>',
  reloj: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7v5l3 2"></path></svg>',
  corazon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg>',
};
---
<Layout seo={p.seo} title="Nosotros · La historia de Cocoa" description="Cocoa nació entre recetas familiares y hornos prestados. Conoce nuestra historia, el equipo y los valores con los que cocinamos." mainClass="inner">
<section class="page-head">
<div class="wrap grid">
<div>
<p class="eyebrow rv">{p.etiqueta}</p>
<h1 class="serif h-xl lines"><Titular value={p.titulo} em="accent" /></h1>
</div>
<p class="lead rv">{p.texto}</p>
</div>
</section>

<section class="sec" style="padding-top:24px" aria-label="Línea de tiempo">
<div class="wrap">
<div class="tl">
<div class="tl-line" aria-hidden="true"><div class="tl-fill" data-scrub="y"></div></div>

{(p.momentos ?? []).map((m) => (
<article class="ti">
<span class="dot" aria-hidden="true"></span>
<div class="t-text rv"><p class="serif yr">{m.anio}</p><h2 class="serif">{m.titulo}</h2><p>{m.texto}</p></div>
<div class="t-media"><div class="ph r-l unmask"><Foto class="px" image={m.foto} w={900} loading="lazy" /></div></div>
</article>
))}

</div>
</div>
</section>

<section class="sec bg-sand round-top" aria-labelledby="team-h">
<div class="wrap">
<div class="split">
<div>
<p class="eyebrow rv">{p.equipoEtiqueta}</p>
<h2 id="team-h" class="serif h-l lines" style="margin-top:18px"><Titular value={p.equipoTitulo} /></h2>
</div>
<p class="lead rv">{p.equipoTexto}</p>
</div>
<div class="team">
{team.map((m) => (
<article class="member rv">
<div class="arch">{m.foto?.asset ? <Foto image={m.foto} w={700} h={880} alt={m.foto.alt || m.nombre} loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" /> : <svg class="hat hat-draw" viewBox="0 0 200 170" role="img" aria-label="Retrato pendiente"><use href="#hat"/></svg>}</div>
<div><h3 class="serif">{m.nombre}</h3><p class="role">{m.cargo}</p><p>{m.bio}</p></div>
</article>
))}
</div>
</div>
</section>

<section class="sec dark" aria-labelledby="val-h">
<div class="wrap">
<p class="eyebrow rv">{p.valoresEtiqueta}</p>
<h2 id="val-h" class="serif h-l lines" style="margin-top:18px"><Titular value={p.valoresTitulo} /></h2>
<div class="vals">
{(p.valores ?? []).map((v) => <div class="val rv"><Fragment set:html={ICONOS[v.icono ?? 'gorro'] ?? ICONOS.gorro} /><h3 class="serif">{v.titulo}</h3><p>{v.texto}</p></div>)}
</div>
<div class="vals-cta rv"><a class="btn light" href="/contacto">{p.valoresBoton}</a></div>
</div>
</section>
</Layout>
