---
import Layout from '../layouts/Layout.astro';
import Titular from '../components/Titular.astro';
import Frase from '../components/Frase.astro';
import Foto from '../components/Foto.astro';
import { getFavorites, getPage, getSettings } from '../lib/sanity';
const p = (await getPage('inicio')) ?? {};
const s = (await getSettings()) ?? {};
const favoritos = await getFavorites();
const cinta = p.cinta ?? [];
---
<Layout seo={p.seo} title="Cocoa · Pastelería & Catering en Pereira" description="Catering, repostería por encargo y chef privado en Pereira y el Eje Cafetero. Hecho a mano, servido con alma." bodyClass="home">
<section class="hero" aria-labelledby="hero-title">
<div class="hero-media" aria-hidden="true">
{(p.portadaFotos ?? []).map((f, i) => <Foto class="hero-slide" image={f} w={1100} widths={[800, 1800]} sizes="100vw" alt="" fetchpriority={i === 0 ? 'high' : undefined} />)}
</div>
<div class="hero-shade"></div>
<div class="specks" aria-hidden="true"></div>
<div class="hero-in">
<img class="hero-hat" src="/assets/img/logos/isotype.svg" alt="" width="104" height="93">
<p class="hero-brand"><b>cocoa</b><small>Pastelería &amp; Catering</small></p>
<h1 id="hero-title" class="serif"><Titular value={p.portadaTitulo} mode="hl" /></h1>
<p class="hero-sub">{p.portadaSubtitulo}</p>
<div class="hero-cta">
<a class="btn light" href="/contacto">{p.portadaBoton} <i class="arr"></i></a>
<a class="link light" href="/reposteria">{p.portadaEnlace}</a>
</div>
</div>
<a class="badge" href="/contacto" aria-label={s.botonCotizar}>
<svg class="ring" viewBox="0 0 100 100" aria-hidden="true"><defs><path id="ring" d="M50 50m-40 0a40 40 0 1 1 80 0a40 40 0 1 1-80 0"/></defs><text><textPath href="#ring" textLength="246">{p.portadaSello}</textPath></text></svg>
<img class="hat" src="/assets/img/logos/isotype.svg" alt="" width="40" height="36">
</a>
<div class="scroll-cue" aria-hidden="true">{p.portadaDesliza}<span></span></div>
<div class="waves" aria-hidden="true">
<svg viewBox="0 0 2880 120" preserveAspectRatio="none"><path d="M0 60C240 0 480 0 720 60S1200 120 1440 60S1920 0 2160 60S2640 120 2880 60V120H0Z"/></svg>
<svg viewBox="0 0 2880 120" preserveAspectRatio="none"><path d="M0 60C240 0 480 0 720 60S1200 120 1440 60S1920 0 2160 60S2640 120 2880 60V120H0Z"/></svg>
</div>
</section>

<div class="marquee" aria-hidden="true">
<div class="mq">
{cinta.map((w) => <><span>{w}</span><i></i></>)}
{cinta.map((w) => <><span>{w}</span><i></i></>)}
</div>
</div>

<div class="linewrap">
<svg class="pageline" viewBox="0 0 100 1000" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" vector-effect="non-scaling-stroke" d="M40 0 C80 60 92 120 70 200 C48 280 12 300 18 380 C24 460 88 470 84 560 C80 650 20 660 26 760 C30 840 70 880 60 1000"/></svg>

<section class="sec">
<div class="wrap intro">
<div>
<p class="eyebrow rv">{p.cocinaEtiqueta}</p>
<h2 class="serif statement" data-split><Frase value={p.cocinaFrase} /></h2>
<div class="facts">
{(p.cocinaPuntos ?? []).map((x) => <div class="rv"><h3 class="serif">{x.titulo}</h3><p>{x.texto}</p></div>)}
</div>
</div>
<div class="intro-media">
<div class="ph arch unmask"><Foto class="zoom" image={p.cocinaFoto} w={1000} loading="lazy" /></div>
<div class="ph d coin"><Foto class="px" image={p.cocinaFotoPequena} w={500} loading="lazy" /></div>
</div>
</div>
</section>

<section class="sec" style="padding-top:0" aria-labelledby="svc-title">
<div class="wrap svc">
<div class="svc-side">
<p class="eyebrow rv">{p.serviciosEtiqueta}</p>
<h2 id="svc-title" class="serif h-l lines"><Titular value={p.serviciosTitulo} /></h2>
<p class="lead rv">{p.serviciosTexto}</p>
<a class="link rv" href="/contacto">{s.botonCotizar} <i class="arr"></i></a>
</div>
<div class="cards">
{(p.serviciosTarjetas ?? []).map((t, i) => (
<article class="card" style={`--n:${i}`}>
<div class={i === 2 ? 'ph d unmask' : 'ph unmask'}><Foto image={t.foto} w={1000} loading="lazy" /></div>
<div class="card-body">
<p class="eyebrow">{t.etiqueta}</p>
<h3 class="serif">{t.titulo}</h3>
<p>{t.texto}</p>
<a class="link" href={t.destino ?? '/catering'}>{t.enlace} <i class="arr"></i></a>
</div>
</article>
))}
</div>
</div>
</section>
</div>

<section class="sec dark round-top strip" aria-labelledby="strip-title">
<div class="wrap split">
<div>
<p class="eyebrow rv">{p.favoritosEtiqueta}</p>
<h2 id="strip-title" class="serif h-l lines" style="margin-top:18px"><Titular value={p.favoritosTitulo} /></h2>
</div>
<a class="link light rv" href="/reposteria">{p.favoritosEnlace} <i class="arr"></i></a>
</div>
<div class="strip-box" tabindex="0" role="region" aria-label="Postres destacados, desliza para ver más">
<div class="track">
{favoritos.map((d) => <article class="dcard"><div class="ph arch"><Foto image={d.foto} w={700} loading="lazy" /></div><h3 class="serif">{d.nombreInicio || d.nombre}</h3><span>{d.categoria?.nombreCorto || d.categoria?.nombre}</span></article>)}
</div>
</div>
<div class="wrap rail" aria-hidden="true"><span>{p.favoritosDesliza}</span><b><i></i></b></div>
</section>

<section class="sec" aria-labelledby="story-title">
<div class="wrap story">
<div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><clipPath id="gorro" clipPathUnits="objectBoundingBox"><path d="M.16 .66 C.03 .62 0 .45 .08 .35 C.15 .26 .27 .26 .33 .31 C.35 .12 .58 .04 .67 .2 C.79 .1 .98 .2 .95 .38 C1 .47 .97 .6 .86 .66 L.86 .96 C.86 .98 .84 1 .82 1 L.2 1 C.18 1 .16 .98 .16 .96 Z"/></clipPath></defs></svg>
<div class="ph hatclip rv"><Foto class="px" image={p.historiaFoto} w={1000} loading="lazy" /></div>
</div>
<div>
<p class="eyebrow rv" id="story-title">{p.historiaEtiqueta}</p>
<blockquote class="serif quote" data-split><Frase value={p.historiaCita} /></blockquote>
<p class="lead rv">{p.historiaTexto}</p>
<a class="link rv" href="/nosotros">{p.historiaEnlace} <i class="arr"></i></a>
</div>
</div>
</section>

<section class="cta sec" aria-labelledby="cta-title">
<div class="cta-bg"></div>
<div class="wrap">
<span class="iso" aria-hidden="true"></span>
<h2 id="cta-title" class="serif h-xl lines"><Titular value={p.finalTitulo} /></h2>
<p class="rv">{p.finalTexto}</p>
<a class="btn rv" href="/contacto">{p.finalBoton} <i class="arr"></i></a>
</div>
</section>
</Layout>
