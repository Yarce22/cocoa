---
import Layout from '../layouts/Layout.astro';
import PaginaServicios from '../components/PaginaServicios.astro';
import { getPage, getSettings } from '../lib/sanity';
const p = (await getPage('catering')) ?? {};
const s = (await getSettings()) ?? {};
---
<Layout seo={p.seo} title="Catering para eventos y chef privado · Cocoa" description="Catering para bodas, empresas y celebraciones en el Eje Cafetero: menú a la medida, montaje, meseros y loza. También chef privado en casa." mainClass="inner">
<PaginaServicios p={p} boton={s.botonCotizar} />
</Layout>
