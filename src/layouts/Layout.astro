---
import Titular from '../components/Titular.astro';
import { getSettings, type Seo } from '../lib/sanity';
interface Props { title: string; description: string; seo?: Seo | null; bodyClass?: string; mainClass?: string; scripts?: string[] }
const { seo, bodyClass, mainClass, scripts = [] } = Astro.props;
const title = seo?.titulo || Astro.props.title;
const description = seo?.descripcion || Astro.props.description;
const s = (await getSettings()) ?? {};
const wa = `https://wa.me/${s.whatsapp ?? ''}`;
---
<!doctype html>
<html lang="es-CO">
<head>
<meta charset="utf-8">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#3B2418">
<link rel="icon" href="/assets/img/logos/isotype.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/logos/isotype.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400;1,600&display=swap">
<link rel="stylesheet" href="/assets/css/styles.css">
<script is:inline>try{sessionStorage.cocoaSeen&&document.documentElement.classList.add('seen')}catch(e){}</script>
</head>
<body class={bodyClass}>
<slot name="before" />
<a class="skip-link" href="#main">Saltar al contenido</a>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="wa" viewBox="0 0 24 24"><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.6l-.5.6c.6 1.2 1.6 2.2 2.8 2.8l.6-.5c.2-.1.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3-.1.6-.6.8-1.3.6-3.4-.2-5-1.8S8.4 9.9 9 8.6z"/></symbol>
</defs></svg>

<header class="nav">
<div class="nav-in">
<a class="nav-logo" href="/" aria-label="Cocoa, ir al inicio">
<img src="/assets/img/logos/isotype.svg" alt="" width="48" height="43">
<span><b>cocoa</b><small>Pastelería &amp; Catering</small></span>
</a>
<nav class="nav-links" aria-label="Principal">
<a class="nl" href="/catering">{s.menuCatering}</a>
<a class="nl" href="/reposteria">{s.menuReposteria}</a>
<a class="nl" href="/galeria">{s.menuGaleria}</a>
<a class="nl" href="/nosotros">{s.menuNosotros}</a>
<a class="btn" href="/contacto">{s.botonCotizar}</a>
</nav>
<button class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mmenu"><i></i><i></i></button>
</div>
</header>

<nav class="mmenu" id="mmenu" aria-label="Menú móvil" inert>
<ul>
<li><a class="ml" style="--n:0" href="/"><small>01</small><span>{s.menuInicio}</span></a></li>
<li><a class="ml" style="--n:1" href="/catering"><small>02</small><span>{s.menuCatering}</span></a></li>
<li><a class="ml" style="--n:2" href="/reposteria"><small>03</small><span>{s.menuReposteria}</span></a></li>
<li><a class="ml" style="--n:3" href="/galeria"><small>04</small><span>{s.menuGaleria}</span></a></li>
<li><a class="ml" style="--n:4" href="/nosotros"><small>05</small><span>{s.menuNosotros}</span></a></li>
</ul>
<div class="mmenu-foot">
<a class="btn light" href="/contacto">{s.botonCotizar} <i class="arr"></i></a>
<p><a href={wa}>WhatsApp {s.whatsappVisible}</a> · {s.ciudadCorta}</p>
</div>
</nav>

<main id="main" class={mainClass}>
<slot />
</main>
<slot name="after" />

<footer class="ft">
<div class="wrap">
<div class="ft-top">
<p class="ft-big serif lines"><Titular value={s.pieTitulo} /></p>
<a class="btn light rv" href="/contacto">{s.botonCotizar} <i class="arr"></i></a>
</div>
<div class="ft-grid">
<div class="ft-brand rv">
<img src="/assets/img/logos/logo-white.svg" alt="Cocoa Pastelería &amp; Catering" width="200" height="102" loading="lazy">
<p>{s.pieDescripcion}</p>
</div>
<div class="rv">
<p class="ft-h">{s.pieExplora}</p>
<ul class="ft-list">
<li><a href="/catering">{s.menuCatering}</a></li>
<li><a href="/reposteria">{s.menuReposteria}</a></li>
<li><a href="/galeria">{s.menuGaleria}</a></li>
<li><a href="/nosotros">{s.menuNosotros}</a></li>
<li><a href="/contacto">{s.botonCotizar}</a></li>
</ul>
</div>
<div class="rv">
<p class="ft-h">{s.pieHablemos}</p>
<ul class="ft-list">
<li><a href={wa}>WhatsApp {s.whatsappVisible}</a></li>
{s.email && <li><a href={`mailto:${s.email}`}>{s.email}</a></li>}
{s.ciudad && <li class="dim">{s.ciudad}</li>}
{s.nota && <li class="dim">{s.nota}</li>}
</ul>
</div>
<div class="ft-brand rv">
<p class="ft-h" style="margin:0">{s.pieSiguenos}</p>
<div class="socs">
{s.instagram && <a class="soc" href={s.instagram} aria-label="Instagram de Cocoa"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6"/></svg></a>}
{s.tiktok && <a class="soc" href={s.tiktok} aria-label="TikTok de Cocoa"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.4 5 4.6"/></svg></a>}
{s.facebook && <a class="soc" href={s.facebook} aria-label="Facebook de Cocoa"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14.5 21v-8h2.7l.4-3.2h-3.1V7.9c0-.9.3-1.6 1.6-1.6h1.6V3.5c-.8-.1-1.6-.2-2.4-.2-2.4 0-4 1.5-4 4.1v2.4H8.6V13h2.7v8"/></svg></a>}
</div>
<p style="font-size:14px">{s.usuarioRedes}</p>
</div>
</div>
<p class="ft-word serif" aria-hidden="true">COCOA</p>
<div class="ft-base">
<span>{s.pieCopyright}</span>
<span>{s.pieFirma}</span>
</div>
</div>
</footer>

<a class="fab" href={wa} aria-label={`${s.botonWhatsapp ?? ''} por WhatsApp`.trim()}>
<span class="fab-l">{s.botonWhatsapp}</span>
<span class="fab-c"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#wa"/></svg></span>
</a>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" integrity="sha384-g4NTh/Iv5PPU4xPyhEWqPcwtNXOvdaDI8LLnyYfyNZOjKJeYQyjzQ9X5275eBjpt" crossorigin="anonymous" defer></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" integrity="sha384-Z3REaz79l2IaAZqJsSABtTbhjgOUYyV3p90XNnAPCSHg3EMTz1fouunq9WZRtj3d" crossorigin="anonymous" defer></script>
<script is:inline src="/assets/js/main.js" defer></script>
{scripts.map((s) => <script is:inline src={`/assets/js/${s}.js`} defer></script>)}
</body>
</html>
